@startuml C4_Context
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include p3-c4-styles.puml 

title Диаграмма контекста C4: Сервисы "Умный дом" PropDevelopment

Person(owner, "Собственник", "Владелец жилья в ЖК PropDevelopment.\nУправляет доступом через мобильное приложение.")
Person(guest, "Гость/Посетитель", "Посетитель ЖК.\nИспользует домофон для входа в подъезд,\nавтомобиль для въезда на территорию.")

System(tenant_mobile, "Мобильное приложение PropDevelopment", "Приложение для собственников.\nУправление Умным домом, ЖКУ, доступом.\nЗарегистрированные пользователи: собственники.")

System_Ext(smart_home_platform, "Платформа партнёра 'Умный дом'", "Внешняя платформа, предоставляющая API:\n- Управление домофонами\n- Управление шлагбаумами\n- Обработка биометрии (распознавание лиц)\n- Распознавание автомобильных номеров")

System_Boundary(devices, "Устройства на территории ЖК") {
    System_Ext(smart_intercom, "Интеллектуальный домофон", "Устройство с видеокамерой.\nФункции: видеосвязь, биометрия (лица),\nудалённое/автоматическое открытие двери.")
    System_Ext(smart_barrier, "Интеллектуальный шлагбаум", "Устройство с камерой распознавания номеров.\nФункции: управление шлагбаумом,\nраспознавание гос. номеров,\nавтоматическое открытие.")
}

Rel(owner, tenant_mobile, "Управляет доступом, настраивает списки разрешённых лиц/автомобилей", "HTTPS")
Rel(guest, smart_intercom, "Вызывает собственника, предъявляет лицо для распознавания", "Video/Audio")
Rel(guest, smart_barrier, "Подъезжает на автомобиле с гос. номером", "Физический доступ")

Rel(tenant_mobile, smart_home_platform, "Получает статус устройств, отправляет команды (открыть дверь/шлагбаум), управляет списками доступа", "HTTPS/REST API, JSON")

Rel(smart_home_platform, smart_intercom, "Отправляет команды открытия, получает события (вызов, распознавание лица), управляет биометрическими шаблонами", "MQTT/HTTPS")
Rel(smart_home_platform, smart_barrier, "Отправляет команды открытия, получает события распознавания номеров, управляет списками гос. номеров", "MQTT/HTTPS")

Rel(smart_intercom, owner, "Отправляет видеовызов при запросе гостя", "Push-уведомление через мобильное приложение", "Асинхронно")
Rel(smart_barrier, owner, "Уведомляет о событиях въезда/распознавания", "Push-уведомление через мобильное приложение", "Асинхронно")

@enduml
